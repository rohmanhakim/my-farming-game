[gd_resource type="Resource" script_class="CropCatalog" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/core/CropCatalog.cs" id="1_catalog"]
[ext_resource type="Script" path="res://scripts/core/CropDefinition.cs" id="2_crop"]

[sub_resource type="Resource" id="Resource_carrot"]
script = ExtResource("2_crop")
Id = "carrot"
SeedItem = "carrot_seeds"
HarvestItem = "carrot"
DaysToHarvest = 3
HarvestCount = 1
SpritePrefix = "crop_carrot"

[sub_resource type="Resource" id="Resource_sunsprout"]
script = ExtResource("2_crop")
Id = "sun_sprout"
SeedItem = "flower_seeds"
HarvestItem = "sun_sprout"
DaysToHarvest = 4
HarvestCount = 1
SpritePrefix = "crop_flower"

[resource]
script = ExtResource("1_catalog")
Crops = Array[Resource]([SubResource("Resource_carrot"), SubResource("Resource_sunsprout")])
